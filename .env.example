# BillMate Local & Cloud-Native Environment Configuration Template
# Copy this file to backend/.env for local development or Docker execution:
# cp .env.example backend/.env
# NEVER commit real credentials or .env files to Git.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=production
# Frontend host port mapping (defaults to 8080; use 8081 if 8080 is bound by host services)
FRONTEND_PORT=8080

# ==============================================================================
# CORS & FRONTEND CLIENT ORIGINS
# ==============================================================================
# Comma-separated list of allowed frontend origins (in addition to built-in origins)
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# ==============================================================================
# DATABASE (MongoDB Atlas)
# ==============================================================================
# MongoDB Atlas Connection String
# Ensure your current IP or 0.0.0.0/0 (for containers) is whitelisted in MongoDB Atlas Network Access.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/billmate?retryWrites=true&w=majority

# ==============================================================================
# AUTHENTICATION (JWT)
# ==============================================================================
# Required in production: Minimum 32-character random secret string
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# ==============================================================================
# EMAIL SERVICE (Resend)
# ==============================================================================
# API key from resend.com
RESEND_API_KEY=re_your_api_key_here
# Verified sender domain address (e.g. BillMate <notifications@yourdomain.com>)
RESEND_FROM_EMAIL=BillMate <onboarding@resend.dev>
# Set to true to print email contents to backend console without sending
MOCK_EMAIL=false
# Recipient email address for /contact form submissions
CONTACT_TO=support@billmate.app

# ==============================================================================
# OPTIONAL AI / ASSISTANT INTEGRATIONS
# ==============================================================================
# Google Gemini API key
GEMINI_API_KEY=
# Dify AI Agent credentials (optional)
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1

# ==============================================================================
# OPTIONAL AWS S3 STORAGE (Falls back to local filesystem if unset)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_REGION=us-east-1
