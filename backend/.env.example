PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/billmate
JWT_SECRET=replace-with-a-long-random-secret

# Dify Agent app configuration
DIFY_APP_API_KEY=app-your-dify-app-key
DIFY_BASE_URL=https://api.dify.ai/v1
# Generate a long random value and configure the same value in the Dify tool header.
DIFY_BACKEND_TOOL_SECRET=replace-with-a-long-random-secret

# Resend variables
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=BillMate <noreply@your-verified-domain.com>
MOCK_EMAIL=false
