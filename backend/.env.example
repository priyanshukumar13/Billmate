PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/billmate
JWT_SECRET=replace-with-a-long-random-secret

# Preferred SMTP variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="BillMate Security" <your-sender@gmail.com>
MOCK_EMAIL=false
